              <mxPoint x="1182" y="306" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="221IrCQpB0Xr7pnIm8Ab-119" value="Alike to a Spiritmancer. uses mana&amp;nbsp;&lt;div&gt;to summon ethereal spirit animals. skills related to the&amp;nbsp;&lt;/div&gt;&lt;div&gt;summoned animal. only have some mid range skills self.&lt;/div&gt;&lt;div&gt;- single summon&lt;/div&gt;&lt;div&gt;- companion&lt;/div&gt;&lt;div&gt;- high summon damage&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=50;align=center;verticalAlign=middle;strokeWidth=1;autosize=1;spacing=4;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" vertex="1" parent="1">
