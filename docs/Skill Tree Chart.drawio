          <mxGeometry x="92" y="841" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="221IrCQpB0Xr7pnIm8Ab-117" value="Gather souls from monsters and bosses&lt;div&gt;and use it to create and summon golems&amp;nbsp;&lt;/div&gt;&lt;div&gt;to fight for you. Create elemental golems.&lt;/div&gt;&lt;div&gt;- multi&amp;nbsp; Summon&lt;/div&gt;&lt;div&gt;- low damage class&lt;/div&gt;&lt;div&gt;- mid range spells&lt;/div&gt;&lt;div&gt;- soul energy harvest skill&lt;/div&gt;&lt;div&gt;- uses soul energy and mana to summon&lt;/div&gt;&lt;div&gt;- mid to high summon damage&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=1;arcSize=50;align=center;verticalAlign=middle;strokeWidth=1;autosize=1;spacing=4;treeFolding=1;treeMoving=1;newEdgeStyle={&quot;edgeStyle&quot;:&quot;entityRelationEdgeStyle&quot;,&quot;startArrow&quot;:&quot;none&quot;,&quot;endArrow&quot;:&quot;none&quot;,&quot;segment&quot;:10,&quot;curved&quot;:1,&quot;sourcePerimeterSpacing&quot;:0,&quot;targetPerimeterSpacing&quot;:0};" vertex="1" parent="1">
          <mxGeometry x="1246" y="174" width="259" height="146" as="geometry" />
        </mxCell>
        <mxCell id="221IrCQpB0Xr7pnIm8Ab-118" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=none;endArrow=none;segment=10;curved=1;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;rounded=0;" edge="1" target="221IrCQpB0Xr7pnIm8Ab-117" parent="1" source="221IrCQpB0Xr7pnIm8Ab-59">
